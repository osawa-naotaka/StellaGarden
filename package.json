{
    "name": "stellagarden",
    "private": true,
    "version": "0.0.9",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "bun run build && vite preview",
        "deploy": "bun run build && wrangler deploy",
        "check": "biome check --write ./src ./worker",
        "cf-typegen": "wrangler types",
        "migrate": "wrangler d1 migrations apply stellagarden-db",
        "initdb": "wrangler d1 execute stellagarden-db --local --file=./migrations/0001_init-schema.sql"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^9.2.0",
        "@mui/material": "^9.2.0",
        "alea": "^1.0.1",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.12.29",
        "idb-keyval": "^6.3.0",
        "jose": "^6.2.3",
        "pixi-viewport": "^6.0.3",
        "pixi.js": "^8.19.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-markdown": "^10.1.0",
        "react-router": "^8.2.0",
        "remark-gfm": "^4.0.1",
        "simplex-noise": "^4.0.3",
        "uuid": "^14.0.1",
        "valibot": "^1.4.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.3",
        "@cloudflare/vite-plugin": "^1.44.0",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "drizzle-kit": "^0.31.10",
        "fast-png": "^8.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.1.4",
        "wrangler": "^4.110.0"
    }
}
