{
	"name": "stellagarden",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "bun run build && vite preview",
		"deploy": "bun run build && wrangler deploy",
		"check": "biome check --write ./src ./worker",
		"cf-typegen": "wrangler types",
		"migrate": "wrangler d1 migrations apply stellagarden-db",
		"initdb": "wrangler d1 execute stellagarden-db --local --file=./migrations/0001_init-schema.sql"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@github/copilot": "^1.0.32",
		"@mui/icons-material": "^7.3.10",
		"@mui/material": "^7.3.10",
		"alea": "^1.0.1",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.14",
		"idb-keyval": "^6.2.2",
		"jose": "^6.2.2",
		"pixi-viewport": "^6.0.3",
		"pixi.js": "^8.18.1",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"react-router": "^7.14.1",
		"simplex-noise": "^4.0.3",
		"uuid": "^13.0.0",
		"valibot": "^1.3.1"
	},
	"devDependencies": {
		"@anthropic-ai/claude-code": "^2.1.114",
		"@biomejs/biome": "^2.4.12",
		"@cloudflare/vite-plugin": "^1.32.3",
		"@types/node": "^24.12.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/uuid": "^11.0.0",
		"@vitejs/plugin-react": "^5.2.0",
		"drizzle-kit": "^0.31.10",
		"fast-png": "^8.0.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.2",
		"wrangler": "^4.83.0"
	}
}
